        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 Claude Code 기록입니다. 입력에는 캐시 읽기·쓰기가 포함되며, 비용은 구독 요금이 아닌 현재 API 단가 기준입니다."
          }
        }
      }
    },
